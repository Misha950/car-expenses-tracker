<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:CarExpensesTracker.Models"
             xmlns:vm="using:CarExpensesTracker.ViewModels"
             x:DataType="vm:RepairsViewModel"
             x:Class="CarExpensesTracker.Views.RepairsView">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="Ремонти та ТО" FontSize="22" FontWeight="SemiBold" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="Дата" />
                    <CalendarDatePicker SelectedDate="{Binding NewDate}" Width="140" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Тип" />
                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding NewType}" Width="100" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Опис робіт" />
                    <TextBox Text="{Binding NewDescription}" Width="240" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Вартість, грн" />
                    <TextBox Text="{Binding NewCost}" Width="110" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Пробіг, км" />
                    <TextBox Text="{Binding NewMileage}" Width="110" />
                </StackPanel>
                <Button Content="Додати" Command="{Binding AddCommand}" VerticalAlignment="Bottom" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="110,90,*,120,110" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="Дата" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Тип" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Опис" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Вартість" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="Пробіг" FontWeight="SemiBold" />
        </Grid>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Records}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:ServiceRecord">
                        <Grid ColumnDefinitions="110,90,*,120,110" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Type}" />
                            <TextBlock Grid.Column="2" Text="{Binding Description}" />
                            <TextBlock Grid.Column="3" Text="{Binding Cost}" />
                            <TextBlock Grid.Column="4" Text="{Binding Mileage}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>