<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CarExpensesTracker.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="vm:ReportsViewModel"
             x:Class="CarExpensesTracker.Views.ReportsView">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="Звіти" FontSize="22" FontWeight="SemiBold" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="З" />
                    <CalendarDatePicker SelectedDate="{Binding FromDate}" Width="140" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="По" />
                    <CalendarDatePicker SelectedDate="{Binding ToDate}" Width="140" />
                </StackPanel>
                <Button Content="Показати" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" />
            </StackPanel>

            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*">
            <lvc:PieChart Grid.Column="0" Series="{Binding CategorySeries}" />
            <lvc:CartesianChart Grid.Column="1" Series="{Binding MonthSeries}" XAxes="{Binding MonthXAxes}" />
        </Grid>
    </DockPanel>
</UserControl>