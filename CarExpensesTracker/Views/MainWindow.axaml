<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CarExpensesTracker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="CarExpensesTracker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="600"
        Title="Car Expenses Tracker">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12">
            <Button Content="Заправки" Command="{Binding ShowFuelCommand}" />
            <Button Content="Ремонти/ТО" Command="{Binding ShowRepairsCommand}" />
            <Button Content="Інші витрати" Command="{Binding ShowOtherExpensesCommand}" />
            <Button Content="Звіти" Command="{Binding ShowReportsCommand}" />
        </StackPanel>
        <ContentControl Content="{Binding CurrentPage}" Margin="12" />
    </DockPanel>
</Window>